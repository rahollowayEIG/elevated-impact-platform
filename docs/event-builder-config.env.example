# Server-only deployment configuration. Keep secrets in the host's secret store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Start with an independently configured developer demo account and consent.
DOCUSIGN_ENVIRONMENT=demo
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_ORGANIZATION_ID=
DOCUSIGN_GOLF_TEMPLATE_ID=
DOCUSIGN_VENUE_TEMPLATE_ID=

# Deferred contract cleanup gates. Both must be true to allow sends.
DOCUSIGN_SEND_ENABLED=false
DOCUSIGN_POLICIES_APPROVED=false
