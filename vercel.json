{
  "functions": {
    "api/event-share.js": {
      "includeFiles": "dist/index.html"
    },
    "api/event-image.js": {
      "maxDuration": 30
    },
    "api/eig-build-lab-live-master-scan.js": {
      "includeFiles": "{src/*.jsx,src/components/*.jsx,tests/*.{cjs,mjs}}",
      "maxDuration": 30
    },
    "api/eig-build-lab-live-scan.js": {
      "includeFiles": "{src/components/*.{jsx,css},tests/*.cjs}",
      "maxDuration": 30
    },
    "api/eig-build-lab-live-integrity.js": {
      "includeFiles": "{src/PlatformApp.jsx,src/components/BuildLabLiveOwnerWorkspace.jsx,src/components/BuildLabCloudBackup.jsx,vercel.json,supabase/migrations/*.sql}",
      "maxDuration": 30
    },
    "api/eig-build-lab-ai-review.js": {
      "includeFiles": "{src/*.jsx,src/components/*.jsx,tests/*.{cjs,mjs}}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/events/:slug",
      "destination": "/api/event-share?slug=:slug"
    }
  ]
}
