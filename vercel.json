{
  "functions": {
    "api/event-share.js": {
      "includeFiles": "dist/index.html"
    },
    "api/event-image.js": {
      "maxDuration": 30
    },
    "api/eig-build-lab-scan.js": {
      "includeFiles": "{src/components/InceptionApex.jsx,src/components/FlyerEditor.jsx,src/components/inception-apex.css,tests/inception-apex-browser.cjs}"
    }
  },
  "rewrites": [
    {
      "source": "/events/:slug",
      "destination": "/api/event-share?slug=:slug"
    }
  ]
}
