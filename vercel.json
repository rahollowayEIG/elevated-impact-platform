{
  "functions": {
    "api/event-share.js": {
      "includeFiles": "dist/index.html"
    },
    "api/event-image.js": {
      "maxDuration": 30
    },
    "api/event-builder.js": {
      "maxDuration": 60,
      "includeFiles": "{server/event-builder.cjs,src/lib/eventEstimate.mjs}"
    }
  },
  "rewrites": [
    {
      "source": "/events/:slug",
      "destination": "/api/event-share?slug=:slug"
    }
  ]
}
